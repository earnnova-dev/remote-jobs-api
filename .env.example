# Remote Jobs API — environment variables
# Copy to .env and fill in. The server loads .env from:
#   1. <cwd>/.env
#   2. <package-dir>/.env
#   3. <package-dir>/../../.env
# Existing environment variables always win over .env values.

# HTTP port
PORT=8321

# Upstream fetch cache TTL in seconds
RJA_CACHE_TTL=300

# Where the key store (keys.json) lives. In Kubernetes set this to a
# path on the PVC: /data/keys.json
RJA_KEYS_PATH=./keys.json

# Admin bearer token for /admin/* endpoints. REQUIRED for production.
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RJA_ADMIN_TOKEN=

# When 1, /v1/jobs works without a key. Dev only — leave 0 in production.
RJA_OPEN_MODE=0

# Public base URL used for links (password reset, Stripe success URLs).
RJA_BASE_URL=https://remote-jobs-api.tten.no

# ---------------------------------------------------------------------------
# Password reset email (SMTP) — RECOMMENDED FOR PRODUCTION
# ---------------------------------------------------------------------------
# The reset link is NEVER shown on the website. It is delivered only by email.
# Without SMTP configured, a request fails closed (no link anywhere) so an
# attacker cannot take an account just by knowing its email.
#
# Point this at any SMTP server (your own, a relay, or a provider). IP + port
# are supported (e.g. RJA_SMTP_HOST=10.0.0.5).
RJA_SMTP_HOST=
RJA_SMTP_PORT=587
RJA_SMTP_USER=
RJA_SMTP_PASS=
# From: address on outgoing mail.
RJA_SMTP_FROM=no-reply@remote-jobs-api.tten.no
RJA_SMTP_FROM_NAME=Remote Jobs API
# Port 587 (STARTTLS) is the default. For implicit TLS on 465 set RJA_SMTP_SSL=1.
# RJA_SMTP_SSL=1
# RJA_SMTP_STARTTLS=1
# RJA_SMTP_TIMEOUT=15
#
# Self-host fallback (dev only): if you have NO email server and still need to
# recover a password, set 1 and the link is printed to the SERVER CONSOLE only
# (never to the browser). Leave 0 in production.
RJA_RESET_FALLBACK_LOG=0

# ---------------------------------------------------------------------------
# Stripe (hosted paid tiers)
# ---------------------------------------------------------------------------
# Secret key (sk_live_... / sk_test_...).
RJA_STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for POST /webhooks/stripe.
RJA_STRIPE_WEBHOOK_SECRET=
# Price IDs for each plan (created in Stripe -> Products).
RJA_STRIPE_PRICE_PRO=
RJA_STRIPE_PRICE_TEAM=
